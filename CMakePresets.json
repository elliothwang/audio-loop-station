{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (default CMake generator)",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "release", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
